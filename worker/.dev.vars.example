# Copy to .dev.vars (gitignored) for local `wrangler dev`.
PAYU_MERCHANT_KEY=your_test_merchant_key
PAYU_SALT=your_test_salt
PAYU_BASE_URL=https://test.payu.in
STRIPE_SECRET_KEY=sk_test_...
DUFFEL_API_KEY=duffel_test_...
DUFFEL_PAYMENT_TYPE=balance
# ONDC RSF 2.0 (Flow 10B) — used to sign the on_recon callback we return.
ONDC_UNIQUE_KEY_ID=your_registered_unique_key_id
ONDC_SIGNING_PRIVATE_KEY=base64_ed25519_signing_key
